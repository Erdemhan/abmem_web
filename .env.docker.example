# Optional settings for docker compose. Copy to .env next to docker-compose.yml
# and change only what you need. Without a .env file the defaults below apply.

# Port on this computer: http://localhost:8000/
ABMEM_PORT=8000

# Database password of the container database. It is not reachable from
# outside the Docker network, but change it if you expose the app.
DB_PASSWORD=abmem

# Load the starter resources and scenario templates into an empty database.
ABMEM_LOAD_STARTER_DATA=true

# Leave empty to let the container create and keep its own key.
DJANGO_SECRET_KEY=
